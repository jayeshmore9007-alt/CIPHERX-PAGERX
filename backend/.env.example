PORT=8080
OPERATOR_USER=operator
OPERATOR_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
VAULT_MASTER_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_SECRET
DATA_DIR=./data
# Optional: point to a file containing a VERIFIED Pager SSH host key
PAGERX_KNOWN_HOSTS_FILE=/absolute/path/to/pager_known_hosts
# Optional: backend-side SSH private key (never put this in the app or repo)
PAGERX_SSH_KEY_PATH=/absolute/path/to/pager_ssh_key
